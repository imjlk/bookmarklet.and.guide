{
  "name": "create-bmkl",
  "version": "0.1.0",
  "description": "Create Vite-powered BMKL bookmarklet projects from maintained templates.",
  "homepage": "https://bookmarklet.and.guide",
  "keywords": ["bookmarklet", "create", "scaffold", "vite"],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-bmkl": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs node --shebang && ttsc --project tsconfig.build.json --emitDeclarationOnly",
    "clean": "node ../../scripts/clean-package.mjs",
    "dev": "tsx src/index.ts",
    "prepack": "pnpm --filter create-bmkl... build",
    "pretest": "pnpm --dir ../.. build:packages",
    "test": "node --test test/*.test.mjs",
    "typecheck": "ttsc --noEmit"
  },
  "dependencies": {
    "@bmkl/templates": "workspace:*"
  },
  "devDependencies": {
    "ttsc": "^0.18.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
