{
  "name": "@bmkl/contracts",
  "version": "0.1.0",
  "description": "Runtime-validated BMKL contracts for bridge, manifest, action, and debug payloads.",
  "homepage": "https://bookmarklet.and.guide",
  "keywords": ["bookmarklet", "contracts", "typia"],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && ttsc --project tsconfig.json",
    "clean": "node ../../scripts/clean-package.mjs",
    "prepack": "pnpm --filter @bmkl/contracts... build",
    "pretest": "pnpm build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "ttsc --noEmit"
  },
  "dependencies": {
    "typia": "^13.0.0"
  },
  "devDependencies": {
    "ttsc": "^0.18.0",
    "typescript": "^7.0.2"
  }
}
