{
  "name": "@bmkl/templates",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs node && ttsc --emitDeclarationOnly --rootDir src --outDir dist",
    "clean": "rm -rf dist",
    "typecheck": "ttsc --noEmit"
  },
  "devDependencies": {
    "ttsc": "^0.18.0",
    "typescript": "^7.0.2"
  }
}
