{
  "name": "@bmkl/vite",
  "version": "0.1.0",
  "description": "Vite plugin for building BMKL bookmarklets as IIFE bundles.",
  "homepage": "https://bookmarklet.and.guide",
  "keywords": ["bookmarklet", "plugin", "vite"],
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs node && ttsc --emitDeclarationOnly --rootDir src --outDir dist",
    "clean": "node ../../scripts/clean-package.mjs",
    "prepack": "pnpm --filter @bmkl/vite... build",
    "pretest": "pnpm build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "ttsc --noEmit"
  },
  "dependencies": {
    "@ttsc/unplugin": "^0.18.0"
  },
  "devDependencies": {
    "ttsc": "^0.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "peerDependencies": {
    "ttsc": "^0.18.0",
    "vite": "^8.1.4"
  }
}
