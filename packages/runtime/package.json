{
  "name": "@bmkl/runtime",
  "version": "0.1.0",
  "description": "Browser runtime helpers for isolated BMKL mounts, actions, and postMessage bridges.",
  "keywords": ["bookmarklet", "runtime", "shadow-dom"],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs browser && ttsc --project tsconfig.build.json --emitDeclarationOnly",
    "clean": "node ../../scripts/clean-package.mjs",
    "prepack": "pnpm --filter @bmkl/runtime... build",
    "typecheck": "ttsc --noEmit"
  },
  "dependencies": {
    "@bmkl/contracts": "workspace:*"
  },
  "devDependencies": {
    "ttsc": "^0.18.0",
    "typescript": "^7.0.2"
  }
}
