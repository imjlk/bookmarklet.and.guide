{
  "name": "@bmkl/cli",
  "version": "0.1.0",
  "description": "Command-line tools for creating, developing, building, and debugging BMKL bookmarklets.",
  "keywords": ["bookmarklet", "cli", "vite"],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "bmkl": "./dist/index.js",
    "bmk": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs node --shebang && ttsc --project tsconfig.build.json --emitDeclarationOnly",
    "clean": "node ../../scripts/clean-package.mjs",
    "dev": "tsx src/index.ts",
    "prepack": "pnpm --filter @bmkl/cli... build",
    "typecheck": "ttsc --noEmit"
  },
  "dependencies": {
    "@bmkl/contracts": "workspace:*",
    "@bmkl/core": "workspace:*",
    "@bmkl/templates": "workspace:*"
  },
  "devDependencies": {
    "ttsc": "^0.18.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
