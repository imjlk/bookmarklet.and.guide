{
  "name": "bookmarklet-and-guide",
  "version": "0.1.0",
  "description": "A Vite-first toolkit and guide for building bookmarklets as in-page applications.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.7.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter @bmkl/web build",
    "build:packages": "pnpm --recursive --filter './packages/*' build",
    "clean": "pnpm --recursive run clean",
    "cli": "node scripts/run-cli.mjs",
    "e2e:debug": "pnpm build && node scripts/e2e-debug.mjs",
    "format": "ttsc format",
    "graph": "ttsc-graph",
    "test": "pnpm --filter @bmkl/core test && pnpm --filter @bmkl/templates test && pnpm test:runtime",
    "test:runtime": "pnpm --filter @bmkl/contracts build && pnpm --filter @bmkl/runtime build && node scripts/runtime-smoke.mjs",
    "test:templates": "pnpm build:packages && node scripts/template-smoke.mjs",
    "typecheck": "pnpm -r typecheck",
    "web:deploy": "pnpm --filter @bmkl/web deploy",
    "web:dev": "pnpm --filter @bmkl/web dev",
    "web:preview": "pnpm --filter @bmkl/web preview"
  },
  "devDependencies": {
    "@ttsc/graph": "^0.18.0",
    "@ttsc/lint": "^0.18.0",
    "@ttsc/paths": "^0.18.0",
    "@ttsc/strip": "^0.18.0",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "ttsc": "^0.18.0",
    "typescript": "^7.0.2"
  }
}
